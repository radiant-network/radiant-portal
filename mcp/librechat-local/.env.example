# Copy to .env and fill in the values marked <...>.
#   cp .env.example .env

# --- LibreChat server ---
HOST=0.0.0.0
PORT=3080
MONGO_URI=mongodb://mongodb:27017/LibreChat
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080

# LibreChat's own session-token secrets (NOT related to Keycloak/OIDC).
# Required — the server refuses to boot without them. Generate any long
# random strings, e.g. `openssl rand -hex 32`.
JWT_SECRET=<random-secret>
JWT_REFRESH_SECRET=<random-secret>
# Required to encrypt stored credentials: CREDS_KEY = 32 bytes hex (64 chars),
# CREDS_IV = 16 bytes hex (32 chars). `openssl rand -hex 32` / `openssl rand -hex 16`.
CREDS_KEY=<64-hex-chars>
CREDS_IV=<32-hex-chars>

# --- Keycloak OIDC login (REMOTE Keycloak) ---
# Issuer is the realm base URL; LibreChat auto-discovers endpoints from
# <issuer>/.well-known/openid-configuration.
OPENID_ISSUER=https://<remote-keycloak-host>/realms/<realm>
OPENID_CLIENT_ID=<librechat-client-id>
OPENID_CLIENT_SECRET=<librechat-client-secret>
OPENID_CALLBACK_URL=/oauth/openid/callback
# Any long random string (e.g. `openssl rand -hex 32`).
OPENID_SESSION_SECRET=<random-secret>
# offline_access is required for token reuse (LibreChat needs a refresh token
# to keep the forwarded access token fresh across the session).
OPENID_SCOPE=openid profile email offline_access
# Keep the raw IdP access token so it can be forwarded to the MCP server.
OPENID_REUSE_TOKENS=true
# Optional: how often to force an IdP refresh (default 900000 = 15 min).
# OPENID_REUSE_MAX_SESSION_AGE_MS=900000
# Label on the login button.
OPENID_BUTTON_LABEL=Sign in with Keycloak

ALLOW_SOCIAL_LOGIN=true
# Optional: make login Keycloak-only (no local email/password accounts).
# ALLOW_EMAIL_LOGIN=false
# ALLOW_REGISTRATION=false

# --- AWS Bedrock (LLM provider) ---
BEDROCK_AWS_DEFAULT_REGION=ca-central-1
# Long-term Bedrock API key (AWS console: Bedrock -> API keys). The AWS SDK sends
# it as a bearer token, so no IAM key pair or ~/.aws mount is needed. Do NOT also
# set BEDROCK_AWS_ACCESS_KEY_ID / _SECRET_ACCESS_KEY / _PROFILE.
# Pick a LONG-TERM key: the short-term ones expire in 12h and the stack then
# fails with `Bearer Token has expired`.
BEDROCK_AWS_BEARER_TOKEN=<bedrock-api-key>
# Curated list. All Claude models on Bedrock are INFERENCE_PROFILE-only, so they
# must be called by a profile-prefixed ID — a bare `anthropic.claude-...` returns
# ValidationException. These profiles were confirmed ACTIVE from ca-central-1.
#
# RESIDENCY: there is no `ca.` profile for Claude — `ca.amazon.nova-lite-v1:0` is the
# only Canada-scoped profile in this region. `us.` routes within US regions;
# `global.` may route to any commercial region. `us.` is the tighter of the two.
BEDROCK_AWS_MODELS=us.anthropic.claude-sonnet-5,us.anthropic.claude-opus-5,us.anthropic.claude-haiku-4-5-20251001-v1:0
#
# Prompt caching: LibreChat enables it by default for any model ID containing
# `claude` or `nova` (packages/data-provider/src/bedrock.ts) and appends a
# `cachePoint` block. Claude accepts that in tool-result turns; Nova does NOT —
# it 400s with `extraneous key [cachePoint] is not permitted` as soon as MCP tools
# are attached, so a Nova agent needs Prompt Caching switched off in the UI.
#
# Before adding any model ID, check all three gates:
#   1. Marketplace agreement:  aws bedrock get-foundation-model-availability \
#        --model-id <bare-id> --region ca-central-1 --query agreementAvailability.status
#      (AVAILABLE = usable, NOT_AVAILABLE = Marketplace-blocked)
#   2. Tool use in STREAMING mode (LibreChat always streams) — non-streaming
#      `converse` is not a valid check; e.g. mistral-large passes it and still fails.
#   3. cachePoint tolerance in a tool-result turn, per the note above.
#   Gates 2+3 in one call:
#     curl -s -o /dev/null -w '%{http_code}\n' -H "Authorization: Bearer $BEDROCK_AWS_BEARER_TOKEN" \
#       -H 'Content-Type: application/json' --data @tool-turn.json \
#       "https://bedrock-runtime.ca-central-1.amazonaws.com/model/<url-encoded-id>/converse-stream"
