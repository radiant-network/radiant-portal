/*
   cbtn_tenant.v_pcx_30_pnoc035_eligibility_combined  (VIEW, access-controlled)

   Stand-in for a template upstream does not ship: upstream builds this view with the dbt model
   pcx_tables/starrocks-dbt/starrocks_radiant/models/pcx_30/access_controlled/ac_v_pcx_30_pnoc035_eligibility_combined.sql,
   and this is the access_controlled_view macro rendered with its column spec. build_seed.py skips it once
   pcx_tables/access_controlled_views holds a file of the same name.
   reasoning, brim_url and source_file (BRIM names its exports after the MRN) are PHI; note_id is not projected.
 */

CREATE OR REPLACE VIEW cbtn_tenant.v_pcx_30_pnoc035_eligibility_combined AS
SELECT s.organization_name,
       s.organization_code,
       CASE WHEN s.can_read_phi THEN s.mrn ELSE s.research_id END AS patient_id,
       CASE WHEN s.can_read_phi THEN 'mrn' ELSE 'research_id' END AS patient_id_type,
       s.radiant_patient_id,
       s.variable_name,
       s.generated_value,
       s.eligibility_value,
       CASE WHEN s.can_read_phi THEN s.reasoning END AS reasoning,
       s.confidence,
       s.review_status,
       s.brim_scope,
       CASE WHEN s.can_read_phi THEN s.brim_url END AS brim_url,
       CASE WHEN s.can_read_phi THEN s.source_file END AS source_file,
       s.brim_loaded_at,
       s.can_read_phi
FROM (SELECT src.*,
             p.id AS radiant_patient_id,
             (org_grant.org_code IS NOT NULL OR lab_grant.patient_id IS NOT NULL) AS can_read_phi
      FROM radiant_data_dev.v_pcx_30_pnoc035_eligibility_combined src
      LEFT JOIN radiant_jdbc.public.patient p
        ON p.tenant_code = '{{.TenantCode}}'
       AND p.organization_code = src.organization_code
       AND p.submitter_patient_id_type = 'mrn'
       AND regexp_replace(src.mrn, '^0+', '') <> ''
       AND regexp_replace(p.submitter_patient_id, '^0+', '')
           = regexp_replace(src.mrn, '^0+', '')
      LEFT JOIN (SELECT DISTINCT org_code FROM auth.pii_grant
                 WHERE user_id = substring_index(substr(current_user(), 2), char(39), 1)
                   AND tenant_code = '{{.TenantCode}}') org_grant
        ON org_grant.org_code = src.organization_code
      LEFT JOIN (SELECT DISTINCT patient_id FROM auth.pii_lab_patient
                 WHERE user_id = substring_index(substr(current_user(), 2), char(39), 1)
                   AND tenant_code = '{{.TenantCode}}') lab_grant
        ON lab_grant.patient_id = p.id) s
