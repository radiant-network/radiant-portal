# ============================================================================
# Radiant backend — copy to .env and adjust. Values below target the local
# compose stack (`make docker-run`) as seen from the HOST (`make run`).
# ============================================================================

# --- API server -------------------------------------------------------------
API_PORT=8090
LOG_LEVEL=info
# Comma-separated list; "*" allows any origin. Empty means no origin is allowed.
CORS_ALLOWED_ORIGINS=*
SHUTDOWN_TIMEOUT_SECONDS=30

# --- StarRocks (analytical / genomic data) ----------------------------------
DB_HOST=localhost
DB_PORT=9030
DB_NAME=test_db
DB_USERNAME=root
DB_PASSWORD=
# The compose stack enables SSL on StarRocks. Either point DB_SSL_CA at the CA
# bundle, or set DB_SSL_MODE=skip-verify to use TLS without cert validation.
# Both unset = plaintext connection.
DB_SSL_CA=
DB_SSL_MODE=skip-verify
# Log any query slower than this (milliseconds).
DB_SLOW_QUERY_THRESHOLD_MS=200
# Shared base database holding cross-tenant reference/annotation tables.
# NOTE: snv__variant is NOT here — it is per-tenant.
SHARED_DATABASE=radiant

# --- PostgreSQL (operational / clinical data) -------------------------------
PGHOST=localhost
PGPORT=5432
PGDATABASE=radiant
PGUSER=radiant
PGPASSWORD=radiant
PGSSLMODE=disable
PGSSLROOTCERT=

# --- Keycloak (authentication) ----------------------------------------------
KEYCLOAK_HOST=http://localhost:8080
KEYCLOAK_REALM=CQDG
# Password-grant client, used by mysql-gateway to exchange user credentials for
# a token. Needs "direct access grants"; prefer a public client so no secret is
# needed. Not used by the API server itself.
KEYCLOAK_CLIENT_ID=radiant
KEYCLOAK_CLIENT_SECRET=

# --- User provisioning (Keycloak + Ranger + StarRocks) ----------------------
# Needed by anything that provisions users: cmd/createuser, cmd/create-tenant,
# and POST /{tenant}/users. Read lazily — a deployment that never provisions a
# user does not need them set.

# Service-account client with realm-management roles. The admin client uses the
# client_credentials grant, not a human admin (human admins enforce OTP, which
# makes the password grant fail).
KEYCLOAK_ADMIN_CLIENT_ID=radiant-admin-cli
KEYCLOAK_ADMIN_CLIENT_SECRET=radiant-admin-secret

# Group every newly provisioned user joins. Empty = no group assignment.
# A group name that does not exist in the realm is an error, not a silent skip.
KEYCLOAK_DEFAULT_GROUP=

# Ranger admin API — creates the user and adds them to the tenant's
# <tenant>_user role so Postgres and Ranger stay in sync.
RANGER_URL=http://localhost:6080
RANGER_ADMIN_USER=admin
RANGER_ADMIN_PASSWORD=rangerR0cks!

# authentication_jwt parameters baked into each StarRocks user that is created.
# The JWKS URL is fetched by StarRocks itself, so it uses the in-network host.
STARROCKS_JWT_JWKS_URL=http://keycloak:8080/realms/CQDG/protocol/openid-connect/certs
STARROCKS_JWT_REQUIRED_ISSUER=http://localhost:8080/realms/CQDG
STARROCKS_JWT_REQUIRED_AUDIENCE=radiant

# cmd/createuser only: password applied to provisioned users. An explicitly
# empty value is honored (external-IdP realms have no local credential). The
# API never sets a password.
USER_PASSWORD=

# --- Multi-tenancy feature flags (all default false) ------------------------
# Recreate every tenant's StarRocks views on API startup (CREATE OR REPLACE,
# advisory-locked across replicas). Fatal on error.
VIEW_REFRESH_ON_STARTUP_ENABLED=false
# Bind the active tenant to the request context so reads resolve <code>_tenant
# instead of the radiant_jdbc federation. Flip on only once every tenant's
# views exist and are populated.
TENANT_VIEWS_READ_ENABLED=false
# Run tenant-scoped StarRocks reads AS THE CALLING USER through mysql-proxy so
# Ranger applies masking / row filters. Enable together with
# TENANT_VIEWS_READ_ENABLED, and only once the FE has access_control=ranger.
STARROCKS_PROXY_READ_ENABLED=false
# Required when STARROCKS_PROXY_READ_ENABLED is on.
STARROCKS_PROXY_ADDR=localhost:9031

# --- S3 / MinIO -------------------------------------------------------------
AWS_ENDPOINT_URL=http://localhost:9000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=access
AWS_SECRET_ACCESS_KEY=secret
AWS_USE_SSL=false
S3_PRESIGNED_URL_EXPIRE=60m

# --- External APIs ----------------------------------------------------------
PUBMED_BASE_URL=https://api.ncbi.nlm.nih.gov

# --- Worker -----------------------------------------------------------------
POLL_INTERVAL_MS=1000
CLEAN_UP_INTERVAL_POLL_HOUR=24
PROBE_PORT=9999

# --- mysql-proxy / mysql-gateway sidecars -----------------------------------
# Only needed when running those commands, not the API.
LISTEN_ADDR=:9031
STARROCKS_ADDR=localhost:9030
STARROCKS_SSL_CA=
# mysql-gateway requires TLS on its listener.
TLS_CERT_FILE=
TLS_KEY_FILE=
