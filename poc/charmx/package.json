{
  "name": "charmx-poc",
  "version": "0.0.1",
  "private": true,
  "description": "Standalone POC: two ways of embedding an external app (CharmX) into the Radiant portal with a Keycloak JWT.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/dev.ts",
    "dev": "tsx watch src/dev.ts",
    "charmx": "tsx src/charmx/server.ts",
    "downstream": "tsx src/downstream/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
